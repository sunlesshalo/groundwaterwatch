---
import Base from "../layouts/Base.astro";
import RegionTable from "../components/RegionTable.astro";
import RegionMap from "../components/RegionMap.astro";
import { loadTimeseries, regionsForCountry, severityBand, consecutiveWeeksAtOrBelow } from "../lib/data";

const ts = loadTimeseries();
const regions = regionsForCountry("RO");
const latest = ts.weeks[ts.weeks.length - 1];

const inD4OrWorse = regions.filter((r) => {
  const p = r.weeks[latest]?.mean_percentile;
  return typeof p === "number" && p <= 2;
}).length;
const inD3OrWorse = regions.filter((r) => {
  const p = r.weeks[latest]?.mean_percentile;
  return typeof p === "number" && p <= 5;
}).length;

const longestD3Streak = Math.max(
  ...regions.map((r) => consecutiveWeeksAtOrBelow(r, ts.weeks, 5))
);
---
<Base
  title="Romania — groundwaterwatch"
  description="Romania's groundwater status by NUTS-2 region, updated weekly from NASA GRACE-FO data."
>
  <h1>Romania</h1>
  <p class="lede">
    {inD4OrWorse} of 8 NUTS-2 regions sit at or below the 2nd percentile of
    their NASA baseline as of {latest}. {inD3OrWorse} of 8 are at or below
    the 5th. The longest current streak below the 5th percentile across the
    country is {longestD3Streak} consecutive weeks.
  </p>

  <h2>Map, week of {latest}</h2>
  <RegionMap regions={regions} week={latest} focus="RO" />

  <h2>Regions, latest week ({latest})</h2>
  <RegionTable regions={regions} weeks={ts.weeks} />

  <p style="font-size: 0.85rem; color: var(--ink-soft);">
    "Wks ≤5%" counts the most recent uninterrupted run of weeks where the
    region's area-weighted mean groundwater percentile sat at or below the
    5th. The dashed line in the sparkline is at the 5th percentile.
    București-Ilfov reads from only 3 of the 25 km grid cells, so its
    numbers are flagged "low-N" — the value is directional, not authoritative.
  </p>
</Base>

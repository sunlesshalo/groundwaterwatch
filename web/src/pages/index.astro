---
import Base from "../layouts/Base.astro";
import RegionMap from "../components/RegionMap.astro";
import { loadTimeseries, regionsForCountry, loadUnlLatest, unlLayerHref } from "../lib/data";
import { ledeFacts, ledeClaim } from "../lib/lede";

const ts = loadTimeseries();
const latest = ts.weeks[ts.weeks.length - 1];
const allRegions = ts.regions;

const facts = ledeFacts(ts);
const claim = ledeClaim(facts);
const streak = facts.longestStreak;

const inD4 = (country: "RO" | "HU") =>
  regionsForCountry(country).filter((r) => {
    const p = r.weeks[latest]?.mean_percentile;
    return typeof p === "number" && p <= 2;
  });

const huRegions = regionsForCountry("HU").length;
const roRegions = regionsForCountry("RO").length;
const huInD4 = inD4("HU").length;
const roInD4 = inD4("RO").length;
// Named rather than described, so the geography can't drift from the data.
const roNamesInD4 = inD4("RO")
  .map((r) => r.name)
  .join(", ");

const unl = loadUnlLatest();
const unlHref = unlLayerHref(unl.week_start);
---
<Base title="groundwaterwatch — Europe's hidden drought, mapped weekly">
  <h1>Europe's hidden drought</h1>
  <p class="lede">
    NASA's GRACE-FO satellites have measured how much water sits beneath
    Europe's surface every week since {facts.recordStart} — {facts.recordYears}
    years. In the week of {facts.latestWeek}, the groundwater under Hungary and
    Romania was {claim}.
  </p>

  <h2>NUTS-2 regions, week of {latest}</h2>
  <RegionMap regions={allRegions} />

  <p>
    <strong>Hungary:</strong> {huInD4} of {huRegions} regions sit at or below the
    2nd percentile of their NASA baseline.
    <strong>Romania:</strong> {roInD4} of {roRegions} regions are equally
    depleted{roInD4 > 0 ? ` (${roNamesInD4})` : ""}.
    <strong>{streak.region.name}</strong> ({streak.region.country}) has been below
    the {streak.threshold}th percentile for
    <strong>{streak.weeks} consecutive weeks</strong>.
  </p>

  <h2>NASA's official operational map, week of {unl.week_start}</h2>
  <p style="margin-bottom: 0.6rem;">
    For the current week, here is NASA Goddard's official global groundwater
    percentile visualization, mirrored from
    <a href="https://nasagrace.unl.edu/">nasagrace.unl.edu</a>. Operational
    latency is 2–9 days, so this map runs ahead of the NUTS-2 figures above,
    which come from the slower final archive.
  </p>
  <p>
    <img
      src={unlHref}
      alt={`NASA GRACE-FO groundwater storage percentile map, week of ${unl.week_start}`}
      style="max-width: 100%; height: auto; border: 1px solid var(--line);"
    />
  </p>

  <h2>Per-country pages</h2>
  <ul>
    <li><a href="/ro/">Romania</a> — {roRegions} NUTS-2 regions, full {facts.recordYears}-year trend</li>
    <li><a href="/hu/">Hungary</a> — {huRegions} NUTS-2 regions, full {facts.recordYears}-year trend</li>
  </ul>

  <h2>How to read the percentile</h2>
  <p>
    Every region's score is a <strong>groundwater percentile</strong> against
    NASA's 1948–2014 baseline. A value of 2 means: only in 2% of historical
    weeks at this time of year was the water table this depleted or worse.
    That baseline reaches far further back than our own {facts.recordYears}-year
    archive, so any "driest since" claim on this page is scoped to the archive,
    not to the baseline.
  </p>

  <div class="callout">
    Methodology, sources, and what this dashboard does <em>not</em> measure
    are on the <a href="/methodology/">methodology page</a>. Please read it
    before quoting the numbers.
  </div>
</Base>

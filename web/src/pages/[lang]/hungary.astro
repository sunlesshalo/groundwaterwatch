---
import CountryPage from "../../components/CountryPage.astro";
import { PREFIXED_LOCALES, type Locale } from "../../i18n";

export function getStaticPaths() {
  return PREFIXED_LOCALES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
---
<CountryPage lang={lang} country="HU" />

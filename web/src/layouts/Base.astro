---
import { ogImageHref, withBase } from "../lib/data";
import {
  t,
  pagePath,
  LOCALES,
  LOCALE_NAME,
  OG_LOCALE,
  DEFAULT_LOCALE,
  type Locale,
  type PageKey,
} from "../i18n";

interface Props {
  title: string;
  description?: string;
  lang?: Locale;
  page?: PageKey;
}
const { title, lang = DEFAULT_LOCALE, page = "home", description } = Astro.props;
const s = t(lang);
const desc = description ?? s.homeDescription;

// Absolute URLs: Facebook and friends will not resolve a relative og:image
// reliably, and a card that fails to load is the whole point of the card lost.
// `site` comes from astro.config.mjs — set SITE_URL when deploying anywhere
// other than the production domain.
//
// Trailing slash on directory paths, so the canonical URL is the one the host
// actually serves rather than one that 301s — scrapers charge you for the hop.
const pathname = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, Astro.site).href;
const ogImage = new URL(ogImageHref(), Astro.site).href;

const abs = (l: Locale) => new URL(withBase(pagePath(l, page)), Astro.site).href;
// The methodology page exists only in English, so it must not advertise
// alternates that do not exist.
const alternates = page === "methodology" ? [DEFAULT_LOCALE] : LOCALES;
---
<!doctype html>
<html lang={s.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {alternates.map((l) => (
      <link rel="alternate" hreflang={l} href={abs(l)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={abs(DEFAULT_LOCALE)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="groundwaterwatch" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Groundwater map of Romania and Hungary by region" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="stylesheet" href={withBase("/styles.css")} />
  </head>
  <body>
    <a class="skip-link" href="#main">{s.skipToContent}</a>
    <header class="site-header">
      <a href={withBase(pagePath(lang, "home"))} class="brand">
        {/* Three falling water-table lines. Decorative — the wordmark carries
            the name, so it stays out of the accessibility tree. */}
        <svg class="brand-mark" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
          <path d="M1 4.5 Q5 2.6 9 4.5 T17 4.5" fill="none" stroke="#6a8e6f" stroke-width="1.6" stroke-linecap="round" />
          <path d="M1 9 Q5 7.1 9 9 T17 9" fill="none" stroke="#d28f3a" stroke-width="1.6" stroke-linecap="round" />
          <path d="M1 13.5 Q5 11.6 9 13.5 T17 13.5" fill="none" stroke="#6e1f1f" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        groundwaterwatch
      </a>
      <nav class="site-nav" aria-label={s.nav.sections}>
        <a href={withBase(pagePath(lang, "romania"))} aria-current={page === "romania" ? "page" : undefined}>{s.nav.romania}</a>
        <a href={withBase(pagePath(lang, "hungary"))} aria-current={page === "hungary" ? "page" : undefined}>{s.nav.hungary}</a>
        <a href={withBase(pagePath(lang, "methodology"))} aria-current={page === "methodology" ? "page" : undefined}>{s.nav.methodology}</a>
      </nav>
      <nav class="lang-switch" aria-label={s.langLabel}>
        {LOCALES.map((l) => (
          <a
            href={withBase(pagePath(l, page === "methodology" ? "home" : page))}
            hreflang={l}
            aria-current={l === lang ? "true" : undefined}
            class={l === lang ? "current" : undefined}
          >{LOCALE_NAME[l]}</a>
        ))}
      </nav>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <p>
          Data: NASA GRACE-FO Data Assimilation
          (<a href="https://disc.gsfc.nasa.gov/datasets/GRACEDADM_CLSM025GL_7D_3.0/summary">GRACEDADM_CLSM025GL_7D V3.0</a>)
          and operational maps from <a href="https://nasagrace.unl.edu/">NASA GRACE / NDMC</a>.
          Boundaries: <a href="https://gisco-services.ec.europa.eu/distribution/v2/nuts/">Eurostat NUTS 2021 (1:1M)</a>.
          Code: <a href="https://github.com/sunlesshalo/groundwaterwatch">github.com/sunlesshalo/groundwaterwatch</a>.
        </p>
      </div>
    </footer>
  </body>
</html>

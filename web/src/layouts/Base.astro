---
interface Props {
  title: string;
  description?: string;
}
import { ogImageHref, withBase } from "../lib/data";

const { title, description = "Europe's hidden drought, mapped weekly. NASA GRACE-FO groundwater data for Romania and Hungary at NUTS-2 resolution." } = Astro.props;

// Absolute URLs: Facebook and friends will not resolve a relative og:image
// reliably, and a card that fails to load is the whole point of the card lost.
// `site` comes from astro.config.mjs — set SITE_URL when deploying anywhere
// other than the production domain.
// Trailing slash on directory paths, so the canonical URL is the one the host
// actually serves rather than one that 301s — scrapers charge you for the hop.
const pathname = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, Astro.site).href;
const ogImage = new URL(ogImageHref(), Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="groundwaterwatch" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Groundwater percentile map of Romania and Hungary by NUTS-2 region" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="stylesheet" href={withBase("/styles.css")} />
  </head>
  <body>
    <header class="site-header">
      <a href={withBase("/")} class="brand">groundwaterwatch</a>
      <nav>
        <a href={withBase("/ro/")}>Romania</a>
        <a href={withBase("/hu/")}>Hungary</a>
        <a href={withBase("/methodology/")}>Methodology</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Data: NASA GRACE-FO Data Assimilation
        (<a href="https://disc.gsfc.nasa.gov/datasets/GRACEDADM_CLSM025GL_7D_3.0/summary">GRACEDADM_CLSM025GL_7D V3.0</a>)
        and operational maps from <a href="https://nasagrace.unl.edu/">NASA GRACE / NDMC</a>.
        Boundaries: <a href="https://gisco-services.ec.europa.eu/distribution/v2/nuts/">Eurostat NUTS 2021 (1:1M)</a>.
        Code: <a href="https://github.com/sunlesshalo/groundwaterwatch">github.com/sunlesshalo/groundwaterwatch</a>.
      </p>
    </footer>
  </body>
</html>

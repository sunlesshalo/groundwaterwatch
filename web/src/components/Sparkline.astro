---
/** A year of weekly scores, at thumbnail size.
 *
 * The line is one colour for every row — it encodes shape, not severity, and
 * the band pill in the neighbouring cell already carries severity at contrast
 * that holds. Only the end dot takes the band colour, because it sits on a
 * shape rather than depending on hue alone to be seen.
 */
interface Props {
  values: number[];
  width?: number;
  height?: number;
  color?: string;
  dotColor?: string;
  threshold?: number;
}
const {
  values,
  width = 132,
  height = 34,
  color = "#8a3720",
  dotColor,
  threshold = 5,
} = Astro.props;

const len = values.length;
const yOf = (v: number) => height - (Math.min(Math.max(v, 0), 100) / 100) * (height - 3) - 1.5;
const xOf = (i: number) => (len <= 1 ? width / 2 : (i / (len - 1)) * width);
const points = values.map((v, i) => `${xOf(i).toFixed(1)},${yOf(v).toFixed(1)}`);
const yThreshold = yOf(threshold);
const last = values[values.length - 1];
const lastX = xOf(len - 1);
const lastY = yOf(last);
const area = len ? `M0,${height} L${points.join(" L")} L${width},${height} Z` : "";
// Deterministic: a random id would make every build produce a different page
// for identical data, which is churn in any diff of the output.
let hash = 2166136261;
for (const ch of `${color}|${points.join("")}`) {
  hash = Math.imul(hash ^ ch.charCodeAt(0), 16777619) >>> 0;
}
const uid = `sp-${hash.toString(36)}`;
---
<svg
  class="spark"
  width={width}
  height={height}
  viewBox={`0 0 ${width} ${height}`}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={uid} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color={color} stop-opacity="0.18" />
      <stop offset="100%" stop-color={color} stop-opacity="0.02" />
    </linearGradient>
  </defs>
  <line
    x1="0" x2={width} y1={yThreshold} y2={yThreshold}
    stroke="#b9b099" stroke-dasharray="2 3" stroke-width="0.8"
  />
  <path d={area} fill={`url(#${uid})`} />
  <polyline
    fill="none"
    stroke={color}
    stroke-width="1.6"
    stroke-linejoin="round"
    stroke-linecap="round"
    points={points.join(" ")}
  />
  <circle cx={lastX} cy={lastY} r="2.8" fill={dotColor ?? color} stroke="#fdfbf5" stroke-width="1.2" />
</svg>

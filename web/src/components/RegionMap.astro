---
import { loadMap, loadTimeseries, severityBand, bandColor } from "../lib/data";
import { t, formatDate, formatNumber, INTL_TAG, type Locale } from "../i18n";
import type { Region, MapView } from "../lib/data";

interface Props {
  regions: Region[];
  week?: string;
  showLabels?: boolean;
  focus?: "RO" | "HU" | "ALL";
  lang: Locale;
  /** Adds play/scrub controls over the whole archive. The map renders
   *  identically without JavaScript — playback is an enhancement, not the
   *  only way to read it. */
  timelapse?: boolean;
}
const { regions, week, showLabels = true, focus = "ALL", lang, timelapse = false } = Astro.props;
const str = t(lang);

const ts = loadTimeseries();
const w = week ?? ts.weeks[ts.weeks.length - 1];
const mapData = loadMap();

const view: MapView = focus === "ALL"
  ? mapData
  : mapData.countries[focus];

const visibleRegions = focus === "ALL"
  ? ts.regions
  : ts.regions.filter((r) => r.country === focus);

interface Feature {
  nuts_id: string;
  name: string;
  pct: number | null;
  band: string;
  path: string;
  centroid: { x: number; y: number } | undefined;
}

const features: Feature[] = visibleRegions
  .filter((r) => view.paths[r.nuts_id])
  .map((r) => {
    const pct = r.weeks[w]?.mean_percentile ?? null;
    return {
      nuts_id: r.nuts_id,
      name: r.name,
      pct,
      band: severityBand(pct),
      path: view.paths[r.nuts_id],
      centroid: view.centroids[r.nuts_id],
    };
  });

const tableIds = new Set(regions.map((r) => r.nuts_id));

// Percentiles as integers (x10) keep the inline payload to ~33 KB gzipped for
// the full 1217-week archive — small enough to ship with the page rather than
// fetch, so scrubbing never waits on the network.
const byId = new Map(visibleRegions.map((r) => [r.nuts_id, r]));
const playbackIds = features.map((f) => f.nuts_id);
const playback = timelapse
  ? {
      weeks: ts.weeks,
      locale: INTL_TAG[lang],
      labels: { play: str.timelapsePlay, pause: str.timelapsePause, replay: str.timelapseReplay },
      v: ts.weeks.map((wk) =>
        playbackIds.map((id) => {
          const p = byId.get(id)?.weeks[wk]?.mean_percentile;
          return typeof p === "number" ? Math.round(p * 10) : -1;
        })
      ),
    }
  : null;
const bands = ["d4", "d3", "d2", "d1", "d0", "normal"] as const;
const bandRanges: Record<string, string> = {
  d4: "≤ 2",
  d3: "≤ 5",
  d2: "≤ 10",
  d1: "≤ 20",
  d0: "≤ 30",
  normal: "> 30",
};
---
<figure class="region-map">
  <svg viewBox={view.viewBox} role="img" aria-label={str.mapHeading(formatDate(lang, w))}>
    {features.map((f) => (
      <path
        data-nuts={f.nuts_id}
        d={f.path}
        fill={f.pct === null ? "#e7e1d3" : bandColor(f.band)}
        stroke="#fff"
        stroke-width="1"
      >
        <title>{f.name} — {f.pct === null ? "—" : formatNumber(lang, f.pct)} · {str.bands[f.band]}</title>
      </path>
    ))}
    {showLabels && features.filter((f) => tableIds.has(f.nuts_id) && f.centroid).map((f) => (
      <text
        x={f.centroid!.x}
        y={f.centroid!.y}
        text-anchor="middle"
        dominant-baseline="middle"
        font-size="11"
        font-family="ui-sans-serif, system-ui, sans-serif"
        font-weight="600"
        fill={["d4", "d3"].includes(f.band) ? "#fff" : "#0c1a14"}
        stroke={["d4", "d3"].includes(f.band) ? "rgba(0,0,0,0.2)" : "rgba(255,255,255,0.6)"}
        stroke-width="0.4"
        paint-order="stroke"
      >
        {f.nuts_id}
      </text>
    ))}
  </svg>
  <figcaption>
    <span class="legend">
      {bands.map((b) => (
        <span class="legend-item">
          <span class="swatch" style={`background:${bandColor(b)};`}></span>
          <span class="legend-label">
            {str.bands[b]} <em>({bandRanges[b]})</em>
          </span>
        </span>
      ))}
    </span>
    <span class="caption-source" data-tl-caption>{str.legendCaption(formatDate(lang, w))}</span>
  </figcaption>

  {playback && (
    <div class="tl" data-timelapse>
      <div class="tl-row">
        <button type="button" class="tl-play" data-tl-play aria-describedby="tl-hint">
          {str.timelapsePlay}
        </button>
        <input
          type="range"
          class="tl-scrub"
          min="0"
          max={playback.weeks.length - 1}
          value={playback.weeks.length - 1}
          step="1"
          data-tl-scrub
          aria-label={str.timelapseScrub}
        />
        <label class="tl-speed">
          <span class="tl-speed-label">{str.timelapseSpeed}</span>
          <select data-tl-speed>
            <option value="0.5">0.5×</option>
            <option value="1" selected>1×</option>
            <option value="2">2×</option>
            <option value="4">4×</option>
          </select>
        </label>
      </div>
      <p class="tl-hint" id="tl-hint">{str.timelapseHint(Number(playback.weeks[0].slice(0, 4)))}</p>
      <script type="application/json" data-tl-json set:html={JSON.stringify(playback)}></script>
    </div>
  )}
</figure>

<style>
  .region-map { margin: 1.2rem 0 1.6rem; }
  .region-map svg {
    width: 100%;
    height: auto;
    background: #f0ebde;
    border: 1px solid var(--line);
    display: block;
  }
  .region-map figcaption {
    margin-top: 0.6rem;
    font-size: 0.78rem;
    color: var(--ink-soft);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin-bottom: 0.3rem;
  }
  .legend-item { display: inline-flex; align-items: center; gap: 0.35rem; }
  .swatch {
    display: inline-block;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 2px;
    border: 1px solid rgba(0,0,0,0.1);
  }
  .legend-label em {
    color: var(--ink-soft);
    font-style: normal;
    font-feature-settings: "tnum";
  }
  .caption-source { display: block; }
</style>
<script>
  // Playback is progressive enhancement: without this the map still shows the
  // latest week, server-rendered. Colours must match severityBand()/bandColor()
  // in src/lib/data.ts.
  const BANDS: [number, string][] = [
    [2, "#6e1f1f"], [5, "#b04a2c"], [10, "#d28f3a"], [20, "#e0c068"], [30, "#a8aa6c"],
  ];
  const NORMAL = "#6a8e6f";
  const NO_DATA = "#e7e1d3";
  const BASE_MS = 28; // ms per week at 1x -> ~34s for the full archive

  function colour(tenths: number): string {
    if (tenths < 0) return NO_DATA;
    const pct = tenths / 10;
    for (const [limit, hex] of BANDS) if (pct <= limit) return hex;
    return NORMAL;
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-timelapse]")) {
    const figure = root.closest("figure");
    const json = root.querySelector<HTMLScriptElement>("[data-tl-json]");
    const play = root.querySelector<HTMLButtonElement>("[data-tl-play]");
    const scrub = root.querySelector<HTMLInputElement>("[data-tl-scrub]");
    const speedSel = root.querySelector<HTMLSelectElement>("[data-tl-speed]");
    const caption = figure?.querySelector<HTMLElement>("[data-tl-caption]");
    if (!figure || !json || !play || !scrub) continue;

    const data = JSON.parse(json.textContent || "{}");
    const paths = Array.from(figure.querySelectorAll<SVGPathElement>("path[data-nuts]"));
    const last = data.weeks.length - 1;
    const fmt = new Intl.DateTimeFormat(data.locale, {
      year: "numeric", month: "long", day: "numeric", timeZone: "UTC",
    });
    // Reuse the server-rendered caption's wording, swapping only the date.
    const template = caption?.textContent?.trim() ?? "";
    const renderedDate = fmt.format(new Date(data.weeks[last] + "T00:00:00Z"));

    let i = last;
    let speed = 1;
    let raf: number | null = null;
    let prev = 0;
    let carry = 0; // ms of playback time not yet spent on a whole week

    function draw(index: number) {
      const row = data.v[index];
      for (let n = 0; n < paths.length; n++) paths[n].setAttribute("fill", colour(row[n]));
      if (caption && template) {
        caption.textContent = template.replace(
          renderedDate,
          fmt.format(new Date(data.weeks[index] + "T00:00:00Z"))
        );
      }
      scrub.value = String(index);
    }

    function stop() {
      if (raf !== null) cancelAnimationFrame(raf);
      raf = null;
      prev = 0;
      carry = 0;
      play.textContent = i >= last ? data.labels.replay : data.labels.play;
      play.removeAttribute("data-playing");
    }

    // Time-based rather than one week per timer tick: at 4x the interval would
    // fall under the browser's timer floor and simply stutter, and on a 120Hz
    // screen a fixed interval drifts. Advancing by elapsed time means the
    // duration is honest at every speed.
    function tick(now: number) {
      if (!prev) prev = now;
      carry += now - prev;
      prev = now;
      const perWeek = BASE_MS / speed;
      let moved = false;
      while (carry >= perWeek && i < last) {
        i++;
        carry -= perWeek;
        moved = true;
      }
      if (moved) draw(i);
      if (i >= last) { stop(); return; }
      raf = requestAnimationFrame(tick);
    }

    function start() {
      // Starting from the end means replaying, not sitting still.
      if (i >= last) { i = 0; draw(i); }
      play.textContent = data.labels.pause;
      play.setAttribute("data-playing", "");
      prev = 0;
      carry = 0;
      raf = requestAnimationFrame(tick);
    }

    play.addEventListener("click", () => (raf === null ? start() : stop()));

    scrub.addEventListener("input", () => {
      stop();
      i = Number(scrub.value);
      draw(i);
    });

    // Speed changes apply mid-playback without restarting.
    speedSel?.addEventListener("change", () => {
      speed = Number(speedSel.value) || 1;
      carry = 0;
    });
  }
</script>

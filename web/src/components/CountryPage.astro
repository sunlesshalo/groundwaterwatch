---
import Base from "../layouts/Base.astro";
import RegionTable from "./RegionTable.astro";
import RegionMap from "./RegionMap.astro";
import { loadTimeseries, regionsForCountry, consecutiveWeeksAtOrBelow } from "../lib/data";
import TrendChart from "./TrendChart.astro";
import SeasonHeatmap from "./SeasonHeatmap.astro";
import { t, formatDate, type Locale } from "../i18n";

interface Props {
  lang: Locale;
  country: "RO" | "HU";
}
const { lang, country } = Astro.props;
const s = t(lang);
const name = s.countryName[country];

const ts = loadTimeseries();
const regions = regionsForCountry(country);
const latest = ts.weeks[ts.weeks.length - 1];
const recordYears = Math.floor(
  (Date.parse(latest) - Date.parse(ts.weeks[0])) / (365.25 * 86_400_000)
);

const atOrBelow = (threshold: number) =>
  regions.filter((r) => {
    const p = r.weeks[latest]?.mean_percentile;
    return typeof p === "number" && p <= threshold;
  }).length;

const worstRegion = regions.reduce((best, r) =>
  consecutiveWeeksAtOrBelow(r, ts.weeks, 5) > consecutiveWeeksAtOrBelow(best, ts.weeks, 5) ? r : best
);
const longestStreak = consecutiveWeeksAtOrBelow(worstRegion, ts.weeks, 5);
---
<Base
  lang={lang}
  title={s.countryTitle(name)}
  description={s.countryDescription(name)}
  page={country === "RO" ? "romania" : "hungary"}
>
  <section class="hero hero-compact u-full">
    <div class="hero-inner">
      <p class="eyebrow">NASA GRACE-FO · {formatDate(lang, latest)}</p>
      <h1 class="hero-title">{name}</h1>
      <p class="hero-lede">
        {s.countryLede(atOrBelow(2), regions.length, atOrBelow(5), formatDate(lang, latest))}
        {longestStreak > 0 && ` ${s.countryStreak(longestStreak, worstRegion.name)}`}
      </p>
    </div>
  </section>

  <section class="section u-wide">
    <RegionMap
      lang={lang}
      week={latest}
      focus={country}
      timelapse
      heading={s.countryMapHeading(formatDate(lang, latest))}
      transportLead={s.timelapseHeading(recordYears)}
    />
  </section>

  <section class="section u-wide">
    <div class="section-head">
      {/* Not a playback-tracking date: the table is server-rendered for the
          newest week and does not scrub with the map. */}
      <h2>{s.countryTableHeading(formatDate(lang, latest))}</h2>
    </div>
    <div class="table-scroll">
      <RegionTable regions={regions} weeks={ts.weeks} lang={lang} />
    </div>
    <p class="note" style="margin-top: 0.9rem;">{s.tableNote}</p>
  </section>

  <section class="section u-wide">
    <div class="section-head">
      <h2>{s.trendHeading}</h2>
    </div>
    <TrendChart lang={lang} country={country} />
  </section>

  <section class="section u-wide">
    <div class="section-head">
      <h2>{s.heatmapHeading}</h2>
    </div>
    <SeasonHeatmap lang={lang} country={country} />
  </section>
</Base>

---
import Base from "../layouts/Base.astro";
import RegionMap from "./RegionMap.astro";
import {
  loadTimeseries,
  regionsForCountry,
  loadUnlLatest,
  unlLayerHref,
  withBase,
} from "../lib/data";
import { ledeFacts, ledeClaim } from "../lib/lede";
import TrendChart from "./TrendChart.astro";
import SeasonHeatmap from "./SeasonHeatmap.astro";
import { t, formatDate, pagePath, renderClaim, yearsOf, type Locale } from "../i18n";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const s = t(lang);

const ts = loadTimeseries();
const latest = ts.weeks[ts.weeks.length - 1];
const facts = ledeFacts(ts);
const claim = renderClaim(lang, ledeClaim(facts));
const streak = facts.longestStreak;

const depletedIn = (country: "RO" | "HU") =>
  regionsForCountry(country).filter((r) => {
    const p = r.weeks[latest]?.mean_percentile;
    return typeof p === "number" && p <= 2;
  });

const countries = (["HU", "RO"] as const).map((c) => ({
  code: c,
  name: s.countryName[c],
  total: regionsForCountry(c).length,
  depleted: depletedIn(c),
}));

const unl = loadUnlLatest();
const unlHref = unlLayerHref(unl.week_start);
const startYear = Number(facts.recordStart.slice(0, 4));

// The hero number is a pull-quote of the claim sentence beside it, read off the
// same facts — never a separately computed figure.
const depletedNow = facts.regionsAtOrBelow(2);
---
<Base
  lang={lang}
  title={s.homeTitle}
  description={s.homeDescription}
  page="home"
>
  <section class="hero u-full">
    <div class="hero-inner">
      <div class="hero-text">
        {/* The archive's as-of date, not the map's. Scrubbing moves the map
            and its own readout; the vintage of the data does not change. */}
        <p class="eyebrow">NASA GRACE-FO · {formatDate(lang, latest)}</p>
        <h1 class="hero-title">{s.h1}</h1>
        <p class="hero-intro">{s.intro(startYear)}</p>
      </div>

      <div class="hero-figure">
        <RegionMap
          lang={lang}
          timelapse
          transportLead={s.timelapseHeading(facts.recordYears)}
        />
      </div>

      <div class="hero-stat">
        <p class="stat-figure" aria-hidden="true">
          <span class="stat-value">{depletedNow}</span>
          <span class="stat-rule"></span>
          <span class="stat-total">{facts.totalRegions}</span>
        </p>
        <p class="hero-claim">{s.headline(formatDate(lang, latest), claim)}</p>
      </div>
    </div>
  </section>

  <section class="section u-wide">
    <div class="section-head">
      <h2>{s.breakdownHeading}</h2>
    </div>
    <ul class="findings">
      {countries.map((c) => (
        <li>
          {s.countryLine(
            c.name,
            c.depleted.length,
            c.total,
            c.depleted.map((r) => r.name).join(", ")
          )}
        </li>
      ))}
      <li>{s.streakLine(streak.region.name, streak.weeks, yearsOf(streak.weeks))}</li>
    </ul>
  </section>

  <section class="section u-wide">
    <div class="section-head">
      <h2>{s.trendHeading}</h2>
    </div>
    <TrendChart lang={lang} />
  </section>

  <section class="section u-wide">
    <div class="section-head">
      <h2>{s.heatmapHeading}</h2>
    </div>
    <SeasonHeatmap lang={lang} />
  </section>

  <section class="section u-wide">
    <div class="section-head">
      <h2>{s.unlHeading(formatDate(lang, unl.week_start))}</h2>
      <p>{s.unlBody}</p>
    </div>
    <figure class="mirror">
      <img
        src={unlHref}
        alt={`NASA groundwater map, ${formatDate(lang, unl.week_start)}`}
        width="3300"
        height="2550"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </section>

  <section class="section u-wide">
    <div class="section-head">
      <h2>{s.pagesHeading}</h2>
    </div>
    <ul class="card-grid">
      {countries.map((c) => (
        <li>
          <a class="link-card" href={withBase(pagePath(lang, c.code === "RO" ? "romania" : "hungary"))}>
            <span class="link-card-title">
              {s.pagesLink(c.name, c.total, facts.recordYears)}
            </span>
            <span class="link-card-stat">
              <b>{c.depleted.length}</b>
              <span>/{c.total} · {s.bands.d4}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section u-wide">
    <div class="section-head">
      <h2>{s.explainHeading}</h2>
    </div>
    <p>{s.explainBody(facts.recordYears)}</p>
    <div class="callout">
      {s.methodologyCalloutPre}<a href={withBase(pagePath(lang, "methodology"))}>{s.methodologyLinkText}</a>{lang !== "en" && ` ${s.englishOnlyNote}`}{s.methodologyCalloutPost}
    </div>
  </section>
</Base>

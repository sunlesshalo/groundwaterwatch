---
/** Long-term trend. Two series max (Romania, Hungary), so identity is
 * categorical: reference-palette slots 1 and 2, validated against this site's
 * warm paper surface (#f7f4ec) — worst-pair CVD ΔE 24.7, normal-vision 33.6.
 * Slot 2 sits at 2.91:1 contrast, under the 3:1 bar, so the relief rule
 * applies: both series carry a visible direct label and a legend, never colour
 * alone.
 *
 * The severity hues are deliberately NOT reused here. On this page they mean
 * "how dry", and a colour that means a value must not also mean an identity.
 */
import { loadTimeseries } from "../lib/data";
import { weeklySeries, rollingMean, yearTicks } from "../lib/charts";
import { t, formatNumber, INTL_TAG, type Locale } from "../i18n";

interface Props {
  lang: Locale;
  /** Omit for both countries; set for a single-series country chart. */
  country?: "RO" | "HU";
}
const { lang, country } = Astro.props;
const s = t(lang);

const ts = loadTimeseries();
const WINDOW = 52;

const series = country
  ? [{ code: country, name: s.countryName[country], colour: "#2a78d6", values: rollingMean(weeklySeries(ts, country), WINDOW) }]
  : [
      { code: "RO", name: s.countryName.RO, colour: "#2a78d6", values: rollingMean(weeklySeries(ts, "RO"), WINDOW) },
      { code: "HU", name: s.countryName.HU, colour: "#eb6834", values: rollingMean(weeklySeries(ts, "HU"), WINDOW) },
    ];

const W = 820;
const H = 320;
// right: sized to the widest end label the scale can produce. Measured at 11px
// Georgia Bold — what font-weight:600 resolves to, since Georgia ships no
// semibold — "Magyarország 100/100" is 129.3px. Plus the 10px gap off the end
// point and a small margin: 146. At the previous 92 the label had 82px and HU
// clipped ~6px into the viewBox edge.
// W went 760 -> 820 at the same time so widening the margin costs no plot
// width: 760-34-92 = 634, 820-34-146 = 640.
const PAD = { top: 16, right: 146, bottom: 32, left: 34 };
const plotW = W - PAD.left - PAD.right;
const plotH = H - PAD.top - PAD.bottom;

const n = ts.weeks.length;
const x = (i: number) => PAD.left + (i / (n - 1)) * plotW;
// Full 0-100 scale: the score is a percentile, and truncating the axis would
// overstate the size of the change.
const y = (v: number) => PAD.top + (1 - v / 100) * plotH;

const path = (values: (number | null)[]) => {
  let d = "";
  let pen = false;
  values.forEach((v, i) => {
    if (typeof v !== "number") {
      pen = false;
      return;
    }
    d += `${pen ? "L" : "M"}${x(i).toFixed(1)} ${y(v).toFixed(1)}`;
    pen = true;
  });
  return d;
};

/** Area under a single series, closed to the axis. Only drawn for the
 *  one-series country chart: two overlapping washes would read as a third
 *  colour where they cross. */
const areaPath = (values: (number | null)[]) => {
  const pts: string[] = [];
  let firstX: number | null = null;
  let lastX = 0;
  values.forEach((v, i) => {
    if (typeof v !== "number") return;
    if (firstX === null) firstX = x(i);
    lastX = x(i);
    pts.push(`${pts.length ? "L" : "M"}${x(i).toFixed(1)} ${y(v).toFixed(1)}`);
  });
  if (firstX === null) return "";
  return `${pts.join("")}L${lastX.toFixed(1)} ${y(0).toFixed(1)}L${(firstX as number).toFixed(1)} ${y(0).toFixed(1)}Z`;
};

const ticks = yearTicks(ts.weeks, 8);
const gridValues = [0, 25, 50, 75, 100];

const ends = series.map((sr) => {
  let i = sr.values.length - 1;
  while (i >= 0 && typeof sr.values[i] !== "number") i--;
  return { ...sr, i, v: sr.values[i] as number, labelY: 0 };
});

// Declutter the end labels. In a drought both countries sit near the floor, so
// "Romania 6/100" and "Hungary 1/100" land within a few pixels of each other
// and overprint. Push them apart around their midpoint and clamp to the plot,
// keeping the dots where the data is.
const LABEL_GAP = 15;
{
  const ordered = [...ends].sort((a, b) => y(a.v) - y(b.v));
  ordered.forEach((e) => (e.labelY = y(e.v) + 4));
  for (let k = 1; k < ordered.length; k++) {
    const gap = ordered[k].labelY - ordered[k - 1].labelY;
    if (gap >= LABEL_GAP) continue;
    const shift = (LABEL_GAP - gap) / 2;
    ordered[k - 1].labelY -= shift;
    ordered[k].labelY += shift;
  }
  const top = PAD.top + 8;
  const bottom = PAD.top + plotH;
  for (const e of ordered) e.labelY = Math.max(top, Math.min(bottom, e.labelY));
}

// Hover payload: rounded to tenths, nulls as -1. ~10 KB for both series.
const hover = {
  locale: INTL_TAG[lang],
  weeks: ts.weeks,
  pad: PAD,
  plotW,
  series: series.map((sr) => ({
    name: sr.name,
    colour: sr.colour,
    v: sr.values.map((v) => (typeof v === "number" ? Math.round(v * 10) : -1)),
  })),
};
---
<figure class="chart chart-panel" data-trend>
  {/* The legend carries each series' current value, not just its colour. That
      makes it a direct label in HTML at full size — which is what a phone
      reader gets, since the in-chart end labels are too small to survive the
      scale-down and are hidden there. */}
  <div class="chart-legend">
    {ends.map((e) => (
      <span class="chart-legend-item">
        <span class="chart-key" style={`background:${e.colour};`}></span>
        {e.name} <b>{formatNumber(lang, e.v, 0)}/100</b>
      </span>
    ))}
  </div>

  <div class="chart-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={s.trendAria(WINDOW)} data-trend-svg>
    {gridValues.map((v) => (
      <g>
        <line
          x1={PAD.left} x2={PAD.left + plotW} y1={y(v)} y2={y(v)}
          stroke={v === 50 ? "#c3c2b7" : "#e4e1d7"} stroke-width="1"
          stroke-dasharray={v === 50 ? "4 3" : undefined}
        />
        <text x={PAD.left - 8} y={y(v) + 3.5} text-anchor="end" class="chart-tick">{v}</text>
      </g>
    ))}
    {ticks.map((tk) => (
      <text x={x(tk.index)} y={H - 11} text-anchor="middle" class="chart-tick">{tk.year}</text>
    ))}

    {series.length === 1 && (
      <path d={areaPath(series[0].values)} fill={series[0].colour} opacity="0.1" />
    )}

    {series.map((sr) => (
      <path d={path(sr.values)} fill="none" stroke={sr.colour} stroke-width="2.4"
            stroke-linejoin="round" stroke-linecap="round" />
    ))}

    {/* Drawn after the series: a line crossing this label would otherwise
        strike through it, and the paper halo can only mask what is already
        painted. Clear of the gridline by more than a descender. */}
    <text x={PAD.left + 6} y={y(50) - 11} class="chart-note-text">{s.trendNormal}</text>

    <line class="chart-guide" data-guide x1="0" x2="0" y1={PAD.top} y2={PAD.top + plotH} />
    {series.map((sr) => (
      <circle class="chart-dot" data-dot r="4.5" cx="0" cy="0"
              fill={sr.colour} stroke="#fdfbf5" stroke-width="2" />
    ))}

    {ends.map((e) => (
      <g data-end>
        <circle cx={x(e.i)} cy={y(e.v)} r="4.5" fill={e.colour} stroke="#fdfbf5" stroke-width="2" />
        {/* "/100" rather than a translated word for "percentile": it ties the
            number straight to the 0-100 gridlines beside it, reads the same in
            all three locales, and adds no string needing a native review. */}
        <text x={x(e.i) + 11} y={e.labelY} class="chart-endlabel">
          {e.name} {formatNumber(lang, e.v, 0)}/100
        </text>
      </g>
    ))}

    <rect class="chart-hit" data-hit
          x={PAD.left} y={PAD.top} width={plotW} height={plotH} />
  </svg>
  </div>

  <div class="readout" data-trend-readout hidden aria-hidden="true"></div>
  <figcaption>{s.trendNote(WINDOW)}</figcaption>
  <script type="application/json" data-trend-json set:html={JSON.stringify(hover)}></script>
</figure>

<script>
  // Hover readout. The chart is complete without it — every series carries a
  // direct end label, and the axis is drawn — so this only adds precision.
  for (const fig of document.querySelectorAll<HTMLElement>("[data-trend]")) {
    const svg = fig.querySelector<SVGSVGElement>("[data-trend-svg]");
    const json = fig.querySelector<HTMLScriptElement>("[data-trend-json]");
    const card = fig.querySelector<HTMLElement>("[data-trend-readout]");
    const hit = fig.querySelector<SVGRectElement>("[data-hit]");
    const guide = fig.querySelector<SVGLineElement>("[data-guide]");
    const dots = Array.from(fig.querySelectorAll<SVGCircleElement>("[data-dot]"));
    const endGroups = Array.from(fig.querySelectorAll<SVGGElement>("[data-end]"));
    if (!svg || !json || !card || !hit || !guide) continue;

    const d = JSON.parse(json.textContent || "{}");
    const fmt = new Intl.NumberFormat(d.locale, { maximumFractionDigits: 0 });
    const dateFmt = new Intl.DateTimeFormat(d.locale, {
      year: "numeric", month: "long", timeZone: "UTC",
    });
    const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c]!));
    const n = d.weeks.length;

    function indexFromEvent(e: PointerEvent): number {
      const box = svg.getBoundingClientRect();
      // Client px -> viewBox units. The viewBox is uniformly scaled to the
      // element width, so one ratio does for both axes.
      const scale = box.width / svg.viewBox.baseVal.width;
      const ux = (e.clientX - box.left) / scale;
      const frac = (ux - d.pad.left) / d.plotW;
      return Math.max(0, Math.min(n - 1, Math.round(frac * (n - 1))));
    }

    function show(e: PointerEvent) {
      const i = indexFromEvent(e);
      const box = svg.getBoundingClientRect();
      const scale = box.width / svg.viewBox.baseVal.width;
      const ux = d.pad.left + (i / (n - 1)) * d.plotW;

      const rows = d.series
        .map((sr: any) => ({ sr, v: sr.v[i] }))
        .filter((r: any) => r.v >= 0);
      if (!rows.length) return hide();

      guide.setAttribute("x1", String(ux));
      guide.setAttribute("x2", String(ux));
      guide.setAttribute("data-on", "");

      d.series.forEach((sr: any, k: number) => {
        const dot = dots[k];
        if (!dot) return;
        const v = sr.v[i];
        if (v < 0) { dot.removeAttribute("data-on"); return; }
        const uy = d.pad.top + (1 - v / 1000) * (svg.viewBox.baseVal.height - d.pad.top - d.pad.bottom);
        dot.setAttribute("cx", String(ux));
        dot.setAttribute("cy", String(uy));
        dot.setAttribute("data-on", "");
      });

      // The end labels sit where the readout wants to be; fading them while
      // the pointer is down the line keeps both readable.
      for (const g of endGroups) g.setAttribute("opacity", "0.25");

      card.hidden = false;
      card.innerHTML =
        `<p class="readout-sub">${esc(dateFmt.format(new Date(d.weeks[i] + "T00:00:00Z")))}</p>` +
        rows
          .map(
            (r: any) =>
              `<div class="readout-score"><span class="readout-value" style="color:${r.sr.colour}">${fmt.format(r.v / 10)}</span>` +
              `<span class="readout-of">/100 · ${esc(r.sr.name)}</span></div>`
          )
          .join("");
      card.setAttribute("data-show", "");

      const cw = card.offsetWidth;
      const figBox = fig.getBoundingClientRect();
      const px = box.left - figBox.left + ux * scale;
      const left = px + 14 + cw > box.width ? px - cw - 14 : px + 14;
      card.style.left = `${Math.max(6, left)}px`;
      card.style.top = `${box.top - figBox.top + 10}px`;
    }

    function hide() {
      card.removeAttribute("data-show");
      card.hidden = true;
      guide.removeAttribute("data-on");
      for (const dot of dots) dot.removeAttribute("data-on");
      for (const g of endGroups) g.removeAttribute("opacity");
    }

    hit.addEventListener("pointermove", show);
    hit.addEventListener("pointerdown", show);
    hit.addEventListener("pointerleave", hide);
  }
</script>

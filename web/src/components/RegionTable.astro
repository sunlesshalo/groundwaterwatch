---
import Sparkline from "./Sparkline.astro";
import { type Region, severityBand, bandColor, lastNValues, consecutiveWeeksAtOrBelow } from "../lib/data";
import { t, formatNumber, type Locale } from "../i18n";

interface Props {
  regions: Region[];
  weeks: string[];
  sparkWeeks?: number;
  lang: Locale;
}
const { regions, weeks, sparkWeeks = 52, lang } = Astro.props;
const s = t(lang);
const latest = weeks[weeks.length - 1];

const rows = regions.map((r) => {
  const w = r.weeks[latest];
  const pct = w?.mean_percentile ?? null;
  const band = severityBand(pct);
  const consecD3 = consecutiveWeeksAtOrBelow(r, weeks, 5);
  const sparkValues = lastNValues(r, weeks, sparkWeeks);
  return { r, pct, band, consecD3, sparkValues, validCells: w?.valid_cells ?? 0 };
});
---
<table class="region-table">
  <thead>
    <tr>
      <th>{s.table.region}</th>
      <th class="num">{s.table.score}</th>
      <th>{s.table.band}</th>
      <th class="num">{s.table.weeksBelow}</th>
      <th>{s.table.trend(sparkWeeks)}</th>
    </tr>
  </thead>
  <tbody>
    {rows.map(({ r, pct, band, consecD3, sparkValues, validCells }) => (
      <tr data-row-nuts={r.nuts_id}>
        <td class="cell-region">
          <span class="region-name">{r.name}</span>
          <span class="region-meta">
            {r.nuts_id}
            {validCells <= 3 && <> · <span class="low-n" title={s.lowNTitle(validCells)}>{s.lowN}</span></>}
          </span>
        </td>
        {/* The score stays ink. Tinting it by band would put #e0c068 on paper
            at about 1.5:1 — the pill beside it carries severity in colour, at
            contrast that holds. */}
        <td class="num"><span class="score">{pct === null ? "—" : formatNumber(lang, pct)}</span></td>
        <td>
          <span class={`band ${band}`}>{s.bands[band]}</span>
        </td>
        <td class="num">{consecD3 || ""}</td>
        <td><Sparkline values={sparkValues} dotColor={bandColor(band)} /></td>
      </tr>
    ))}
  </tbody>
</table>
